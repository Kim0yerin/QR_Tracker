<Window x:Class="QR_Tracker.View.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QR_Tracker.View"
        mc:Ignorable="d"
        Title="MainView" Height="450" Width="800">
    <DockPanel>
        <!-- 상단바 -->
        <Grid DockPanel.Dock="Top" Background="LightGray" Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- 제목 영역 -->
                <ColumnDefinition Width="Auto" />
                <!-- 콤보박스 영역 -->
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Loc[QrTrackerTitle]}" 
               FontSize="20" VerticalAlignment="Center" Margin="10" />

            <ComboBox Grid.Column="1"
              ItemsSource="{Binding Languages}"
              SelectedItem="{Binding SelectedLanguage}"
              Width="100"
              VerticalAlignment="Center"
              Margin="10,0,10,0"/>
        </Grid>
        

        <!-- 좌측 메뉴 -->
        <StackPanel DockPanel.Dock="Left" Width="150" Background="#EEE">
            <Button Content="{Binding Loc[QrCreateMenu]}" Command="{Binding ShowQrCreateCommand}"/>
            <Button Content="{Binding Loc[QrDetectMenu]}" Command="{Binding ShowQrDetectCommand}"/>
            <Button Content="{Binding Loc[ReportMenu]}" Command="{Binding ShowReportCommand}"/>
        </StackPanel>

        <!-- 콘텐츠 영역 (여기에 뷰 교체됨) -->
        <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
</Window>

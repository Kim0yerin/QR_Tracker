<UserControl x:Class="QR_Tracker.View.QrCreateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QR_Tracker.View"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="150"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="17"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Loc[QrCreateGuide]}" FontSize="20"/>
            <DockPanel Margin="5" HorizontalAlignment="Center">
                <Label Content="{Binding Loc[Name]}" />
                <TextBox Text="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </DockPanel>
            <DockPanel Margin="5" HorizontalAlignment="Center">
                <Label Content="{Binding Loc[EmployeeNumber]}" />
                <TextBox Text="{Binding EmployeeNumber, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </DockPanel>
            <Button Content="{Binding Loc[Create]}" Command="{Binding CreateCommand}" Margin="0,20,0,0" Width="150"/>
        </StackPanel>
    </Grid>
</UserControl>

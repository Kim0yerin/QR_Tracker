<Application x:Class="QR_Tracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QR_Tracker"
             xmlns:views="clr-namespace:QR_Tracker.View"
             xmlns:viewmodels="clr-namespace:QR_Tracker.ViewModel" 
             StartupUri="View/MainView.xaml">
    <Application.Resources>
        <DataTemplate DataType="{x:Type viewmodels:QrDetectViewModel}">
            <views:QrDetectView/>
        </DataTemplate>
    </Application.Resources>
</Application>
